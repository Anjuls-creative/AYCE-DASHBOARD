# Salin isi file ini ke Streamlit Cloud: App settings -> Secrets
# (atau simpan lokal sebagai .streamlit/secrets.toml — jangan di-commit).
# Jika bagian [users.*] tidak ada, aplikasi memakai akun DEMO (pegawai/pegawai123, bos/bos123).

[users.pegawai]
password = "ganti-password-pegawai"
role = "pegawai"
nama = "Pegawai"

[users.bos]
password = "ganti-password-bos"
role = "bos"
nama = "Pak Bos"

# Tambah akun pegawai lain bila perlu:
# [users.sinta]
# password = "rahasia"
# role = "pegawai"
# nama = "Sinta"
#
# Alternatif tanpa menyimpan password asli: pakai password_sha256 (hex SHA-256 dari password)
# password_sha256 = "..."
